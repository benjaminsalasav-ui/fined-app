# Credenciales de Supabase (cópialas desde tu proyecto en supabase.com)
# 1. Copia este archivo como ".env"  ->  cp .env.example .env
# 2. Pega tus valores reales (Project Settings > API)
# 3. Reinicia el servidor:  npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
